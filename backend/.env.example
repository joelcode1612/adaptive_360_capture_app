SITESENSE_DATABASE_URL=postgresql+asyncpg://sitesense:sitesense@localhost:5432/sitesense
SITESENSE_CAPTURE_STORAGE_ROOT=./var/captures
SITESENSE_MAX_CAPTURE_BYTES=26214400
SITESENSE_MAX_CAPTURE_COUNT=30
SITESENSE_CORS_ORIGINS=["http://localhost:3000"]
# Development only. Production authentication must inject a verified user id.
SITESENSE_ALLOW_DEVELOPMENT_IDENTITY=false
